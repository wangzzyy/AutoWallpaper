<Window x:Class="AutoWallpaper.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoWallpaper · 设置" Height="790" Width="760" MinHeight="680" MinWidth="620"
 WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13" Foreground="#182230">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
  <Style TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Margin" Value="0,5,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#182230"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Margin" Value="0,5,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FFFFFF"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,0,7"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D0D5DD"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,3,0,3"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#344054"/>
   <Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#818CF8"/><Setter TargetName="bd" Property="Background" Value="#EEF2FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#101828"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#475467"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,4,12,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#4F46E5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4F46E5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="AutoWallpaper" FontSize="27" FontWeight="Bold" Foreground="#101828"/>
    <TextBlock Text="自动获取 Unsplash 高清图片，让桌面保持新鲜感" Foreground="#667085" Margin="1,4,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#EDEBFE" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#4F46E5" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="壁纸偏好设置" Foreground="#4338CA" FontWeight="SemiBold"/></StackPanel>
   </Border>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,13" BorderBrush="#E4E7EC" BorderThickness="1">
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Border Background="#EEF2FF" CornerRadius="8" Width="34" Height="34"><TextBlock Text="API" Foreground="#4338CA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Unsplash 连接" Style="{StaticResource CardTitle}"/><TextBlock Text="配置访问密钥、搜索关键词和可选 IP" Foreground="#667085" FontSize="12"/></StackPanel></StackPanel>
      <TextBlock Text="Access Key（必填，在 Unsplash Developers 创建应用获取）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ApiKeyBox"/>
      <TextBlock Text="搜索关键词（可选，例如 nature、architecture）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="QueryBox"/>
      <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,2,0,0">
       <StackPanel>
        <TextBlock Text="高级网络设置" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="API 域名 · api.unsplash.com" Foreground="#475467" FontSize="12"/>
        <DockPanel Margin="0,2,0,3" LastChildFill="True"><Button Content="刷新 IP" Click="RefreshIp_Click" DockPanel.Dock="Right"/><Button Content="DNSChecker" Click="OpenDnsChecker_Click" Tag="api.unsplash.com" DockPanel.Dock="Right"/><TextBox x:Name="ApiIpBox" ToolTip="输入 api.unsplash.com 的 IPv4 地址；留空使用正常 DNS" Margin="0,3,5,3"/></DockPanel>
        <TextBlock Text="图片 CDN · images.unsplash.com" Foreground="#475467" FontSize="12"/>
        <DockPanel Margin="0,2,0,3" LastChildFill="True"><Button Content="刷新 IP" Click="RefreshImageIp_Click" DockPanel.Dock="Right"/><Button Content="DNSChecker" Click="OpenDnsChecker_Click" Tag="images.unsplash.com" DockPanel.Dock="Right"/><TextBox x:Name="ImageIpBox" ToolTip="输入 images.unsplash.com 的 IPv4 地址；留空使用正常 DNS" Margin="0,3,5,3"/></DockPanel>
        <TextBlock Text="两个 IP 独立设置。留空使用系统 DNS；HTTPS 仍校验原始域名，DNS 返回的地址不保证在当前网络中可达。" Foreground="#667085" FontSize="11" Margin="0,2,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
    <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,13" BorderBrush="#E4E7EC" BorderThickness="1">
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Background="#E6F9F2" CornerRadius="8" Width="34" Height="34"><TextBlock Text="壁纸" Foreground="#067647" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="壁纸与缓存" Style="{StaticResource CardTitle}"/><TextBlock Text="设置更新频率、图片方向、显示方式与本地存储" Foreground="#667085" FontSize="12"/></StackPanel></StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="换图间隔（分钟）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1"/>
       <TextBlock Grid.Row="1" Text="桌面适配方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FitBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="WallpaperOptions_SelectionChanged"><ComboBoxItem Content="填充（Fill）"/><ComboBoxItem Content="适应（Fit）"/><ComboBoxItem Content="拉伸（Stretch）"/><ComboBoxItem Content="居中（Center）"/><ComboBoxItem Content="平铺（Tile）"/></ComboBox>
       <TextBlock Grid.Row="2" Text="图片方向" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OrientationBox" Grid.Row="2" Grid.Column="1" SelectedValuePath="Tag" ToolTip="选择 Unsplash 图片方向" SelectionChanged="WallpaperOptions_SelectionChanged"><ComboBoxItem Content="横向（Landscape）" Tag="landscape"/><ComboBoxItem Content="纵向（Portrait）" Tag="portrait"/><ComboBoxItem Content="方形（Squarish）" Tag="squarish"/><ComboBoxItem Content="不限方向（Any）" Tag="any"/></ComboBox>
       <TextBlock x:Name="BeautifyHint" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,9" Padding="10,9" Background="#EEF4FF" Foreground="#3538CD" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Text="提示：填充模式下，纵向图片会自动生成横向美化壁纸，以适配桌面比例；横向图片保持原样。"/>
       <TextBlock Grid.Row="4" Text="缓存目录" Style="{StaticResource FieldLabel}"/><DockPanel Grid.Row="4" Grid.Column="1"><TextBox x:Name="CacheBox"/><Button Content="浏览…" Click="Browse_Click"/></DockPanel>
       <TextBlock Grid.Row="5" Text="缓存图片数量上限" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxCountBox" Grid.Row="5" Grid.Column="1"/>
       <TextBlock Grid.Row="6" Text="缓存最长保留（天）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxDaysBox" Grid.Row="6" Grid.Column="1"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,10" BorderBrush="#E4E7EC" BorderThickness="1">
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Border Background="#FFF4E5" CornerRadius="8" Width="34" Height="34"><TextBlock Text="系统" Foreground="#B54708" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="系统集成" Style="{StaticResource CardTitle}"/><TextBlock Text="控制应用启动方式和 Windows 外观联动" Foreground="#667085" FontSize="12"/></StackPanel></StackPanel>
      <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动（当前用户）"/>
      <CheckBox x:Name="AccentBox" Content="根据当前壁纸自动设置 Windows 强调色"/>
      <CheckBox x:Name="MinimizeBox" Content="关闭设置窗口时最小化到系统托盘" IsChecked="True"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ProgressBar x:Name="BusyProgress" Grid.Row="0" Height="3" Margin="2,0,2,8" IsIndeterminate="True" Visibility="Collapsed"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="#475467" TextWrapping="Wrap" MinHeight="18"/><TextBlock Text="设置会在保存后应用" Foreground="#98A2B3" FontSize="11" Margin="0,2,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NextButton" Content="立即换一张" Click="Next_Click"/><Button Content="保存设置" Click="Save_Click"/><Button Content="保存并隐藏到托盘" Click="SaveAndHide_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
