<Application x:Class="AutoWallpaper.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,4"/></Style>
 </Application.Resources>
</Application>
